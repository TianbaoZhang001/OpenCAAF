# Copy this file to `.env` and fill in your keys.
# .env is gitignored — never commit real credentials.

# Required for all OpenAI executor conditions (GPT-4o, GPT-4o-mini).
OPENAI_API_KEY=sk-...

# Required for Anthropic Claude conditions (Opus 4, Haiku 4.5).
ANTHROPIC_API_KEY=sk-ant-...

# Required for open-weight replication cells (Cohere Command-R7B, Gemma-3-12B-IT).
# Both route through OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-...
