# Copy this file to `.env` and fill in your API key(s).
# `.env` is gitignored.

# OpenAI (default backend)
OPENAI_API_KEY=sk-...

# Optional: route through OpenRouter for open-weight models (e.g., Cohere Command-R7B, Gemma-3-12B-IT)
# CAAF_BACKEND=openrouter
# OPENROUTER_API_KEY=sk-or-...
# CAAF_OPENROUTER_IGNORE=Venice

# Optional: route through Together for open-weight models
# CAAF_BACKEND=together
# TOGETHER_API_KEY=...

# Optional: per-role model overrides (used by the benchmark scripts)
# CAAF_EXECUTOR_MODEL=gpt-4o-mini
# CAAF_REVIEWER_MODEL=gpt-4o-mini
